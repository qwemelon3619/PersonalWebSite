# Version control
.git
.gitignore

# Environment files (never bake secrets into images)
.env*
!.env.example

# Local build / runtime artefacts
bin/
**/tmp/
**/*.log
**/*.db
**/*.sqlite
**/*.test
**/*.out

# Compose files and CI definitions are not needed in image layers
docker-compose*.yml
.github/
.azure/
.vscode/
.idea/
.DS_Store
